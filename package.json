{
  "name": "@moreflow/tracking",
  "version": "0.2.0",
  "description": "Browser-safe acquisition tracking helpers for Moreflow public embeds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moreflow-io/tracking.git"
  },
  "homepage": "https://github.com/moreflow-io/tracking#readme",
  "bugs": {
    "url": "https://github.com/moreflow-io/tracking/issues"
  },
  "keywords": [
    "moreflow",
    "tracking",
    "attribution",
    "browser"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": "./dist/browser.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --bundle --format=esm --minify --outfile=dist/index.js && esbuild src/index.ts --bundle --format=iife --global-name=MoreflowTracking --target=es2019 --minify --outfile=dist/browser.js && tsc --singleThreaded -p tsconfig.build.json",
    "typecheck": "tsc --singleThreaded --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run test && bun run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "unpkg": "./dist/browser.js",
  "jsdelivr": "./dist/browser.js"
}
